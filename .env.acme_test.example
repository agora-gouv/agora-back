# =============================================================================
# ACME — Configuration stub local
# =============================================================================

# Active le renouvellement ACME (obligatoire pour le test)
ACME_ENABLED=true

# Active le mode bouchon : redirige tous les appels ACME et Cloudflare vers
# les stubs intégrés à l'application (endpoints /stub/acme/* et /stub/cloudflare/*)
ACME_STUB_MODE=true

# URL du serveur ACME → pointe vers le stub intégré dans l'application elle-même.
# Le stub expose un répertoire ACME RFC 8555 complet sur /stub/acme/directory.
ACME_SERVER_URL=http://localhost:8080/stub/acme/directory

# URL Cloudflare → pointe vers le stub Cloudflare intégré.
# En production, cette variable n'est pas définie (valeur par défaut : https://api.cloudflare.com/client/v4)
CLOUDFLARE_BASE_URL=http://localhost:8080/stub/cloudflare

# Domaine de test utilisé pour l'order ACME (valeur fictive, jamais résolu en DNS)
ACME_DOMAIN=local.test

# Credentials EAB (External Account Binding) — volontairement vides.
# Le stub ACME répond externalAccountRequired=false, donc aucun EAB n'est requis.
# Le code vérifie leur présence avant d'appeler withKeyIdentifier().
ACME_EAB_KID=
ACME_EAB_HMAC_KEY=

# Clé de chiffrement AES pour les keypairs stockées en base.
# Valeur de test locale (non utilisée en production).
ACME_ENCRYPTION_KEY=xkwY1gKptFSVYLLrSJ7IZwC2NMRcC4mDWyZGxe+cmeg=

# Zone Cloudflare fictive utilisée par le stub Cloudflare
CLOUDFLARE_ZONE_ID=stub-zone-id

# Token Cloudflare fictif (le stub ne valide pas les tokens)
CLOUDFLARE_API_TOKEN=stub-token

# Active les appels vers le serveur ACME (stub en l'occurrence)
ACME_SERVER_INTERACTION_ENABLED=true

# Active le déploiement vers Cloudflare (stub en l'occurrence)
ACME_CLOUDFLARE_INTERACTION_ENABLED=true
